    {
        "id": "0000000000000020",
        "type": "function",
        "z": "0000000000000003",
        "name": "keep last 15",
        "func": "// last 15 alerts, newest first\nconst list = context.get(\"alerts\") || [];\nconst a = msg.payload;\nif (list.some(x => x.id === a.id)) return null;   // duplicate\nlist.unshift({\n    id: a.id,\n    time: new Date(a.timestamp).toLocaleTimeString(\"es-ES\", { timeZone: \"Europe/Madrid\" }),\n    level: a.level, patient: a.patient, room: a.room, reason: a.reason\n});\ncontext.set(\"alerts\", list.slice(0, 15));\nmsg.payload = list.slice(0, 15).map(({ id, ...row }) => row);\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 280,
        "wires": [
