        "type": "function",
        "z": "0000000000000003",
        "name": "new alerts only",
        "func": "// only new alerts\nif (msg.payload.level !== \"ALERT\") return null;\nconst a = msg.payload;\nmsg.payload = `ALERT ${a.patient} (room ${a.room}): ${a.reason.replace(\"<\", \"below\").replace(\">\", \"above\")}`;\nreturn msg;\n",
