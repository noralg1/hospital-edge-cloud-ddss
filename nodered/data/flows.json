        "name": "start/stop crisis",
        "func": "// 60 s crisis, read by the simulator\nif (msg.payload === \"stop\") {\n    global.set(\"crisis\", null);\n    node.status({});\n    return null;\n}\nconst [patient, sign] = msg.payload.split(\":\");\nglobal.set(\"crisis\", { patient, sign, until: Date.now() + 60000 });\nnode.status({ fill: \"red\", shape: \"dot\", text: `${patient} ${sign} for 60 s` });\nreturn null;\n",
