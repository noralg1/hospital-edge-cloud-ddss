    {
        "id": "000000000000000d",
        "type": "function",
        "z": "0000000000000002",
        "name": "check thresholds",
        "func": "// thresholds (illustrative)\nconst LIMITS = {\n    pulse: { min: 40, max: 140 },   // bpm\n    spo2:  { min: 90 }              // %\n};\n\nconst r = msg.payload;\nconst limit = LIMITS[r.sign];\nif (!limit) return null;\n\nconst key = `${r.patient}/${r.sign}`;\nconst state = context.get(key) || { status: \"normal\", lastTs: \"\" };\n\n// QoS 1 can repeat a message -> ignore old/duplicated readings\nif (r.timestamp <= state.lastTs) {\n    node.warn(`duplicate/old reading ignored: ${key} ${r.timestamp}`);\n    return null;\n}\nstate.lastTs = r.timestamp;\n\nlet reason = null;\nif (limit.min !== undefined && r.value < limit.min) reason = `${r.sign} ${r.value} ${r.unit} < ${limit.min}`;\nif (limit.max !== undefined && r.value > limit.max) reason = `${r.sign} ${r.value} ${r.unit} > ${limit.max}`;\nconst status = reason ? \"alarm\" : \"normal\";\n\n// only send something when the state changes\nif (status === state.status) {\n    context.set(key, state);\n    return null;\n}\nstate.status = status;\ncontext.set(key, state);\n\nmsg.topic = `alerts/${r.ward}/room${r.room}`;\nmsg.payload = {\n    id: `${r.patient}|${r.sign}|${r.timestamp}`,\n    level: reason ? \"ALERT\" : \"RESOLVED\",\n    patient: r.patient, ward: r.ward, room: r.room,\n    sign: r.sign, value: r.value, unit: r.unit,\n    reason: reason || `${r.sign} back to normal (${r.value} ${r.unit})`,\n    timestamp: r.timestamp\n};\nnode.status({ fill: reason ? \"red\" : \"green\", shape: \"dot\", text: `${msg.payload.level} ${key}` });\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 140,
        "wires": [
            [
                "000000000000000b",
                "000000000000000c"
            ]
        ]
    },
