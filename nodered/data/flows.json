    {
        "id": "0000000000000008",
        "type": "function",
        "z": "0000000000000001",
        "name": "generate readings",
        "func": "// 3 patients, pulse + spo2 every 10 s\n\nconst patients = [\n    { patient: \"P001\", ward: \"ward2\", room: \"204\" },\n    { patient: \"P002\", ward: \"ward2\", room: \"205\" },\n    { patient: \"P003\", ward: \"ward2\", room: \"206\" }\n];\n\nconst clamp = (v, min, max) => Math.min(max, Math.max(min, v));\nconst drift = (v, step) => v + (Math.random() * 2 - 1) * step;\n\n// crisis button from the dashboard\nconst crisis = global.get(\"crisis\");\nconst active = crisis && Date.now() < crisis.until ? crisis : null;\n\nconst timestamp = new Date().toISOString();   // time of the measurement\nconst last = context.get(\"last\") || {};\n\nfor (const p of patients) {\n    const prev = last[p.patient] || { pulse: 75, spo2: 97 };\n    let pulse = clamp(drift(prev.pulse, 3), 60, 100);\n    let spo2 = clamp(drift(prev.spo2, 0.7), 94, 99.5);\n    last[p.patient] = { pulse, spo2 };\n\n    if (active && active.patient === p.patient) {\n        if (active.sign === \"spo2\") spo2 = 84 + Math.random() * 4;     // < 90 %\n        if (active.sign === \"pulse\") pulse = 145 + Math.random() * 15; // > 140 bpm\n    }\n\n    const readings = [[\"pulse\", Math.round(pulse), \"bpm\"], [\"spo2\", Math.round(spo2), \"%\"]];\n    for (const [sign, value, unit] of readings) {\n        node.send({\n            topic: `hospital/${p.ward}/room${p.room}/${sign}`,\n            payload: { ward: p.ward, room: p.room, patient: p.patient, sign, value, unit, timestamp }\n        });\n    }\n}\ncontext.set(\"last\", last);\n\nnode.status(active\n    ? { fill: \"red\", shape: \"dot\", text: `crisis ${active.patient} ${active.sign}` }\n    : { fill: \"green\", shape: \"dot\", text: `6 readings at ${timestamp.substring(11, 19)} UTC` });\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 140,
        "wires": [
            [
                "0000000000000006",
                "0000000000000007"
            ]
        ]
    },
